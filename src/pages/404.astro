---
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
---

<Page site={site} title="Unclaimed territory" description="No government has claimed this page yet. The maker is at the start, with every government you could want." noindex>
  <div class="eu-prose">
    <h1>Unclaimed territory</h1>
    <p class="eu-lead">No government has claimed this page yet: no flag, no constitution, not even a customs post. Perhaps the map was wrong.</p>
    <p><a class="eu-btn" href="/">Mint a government</a></p>
  </div>
</Page>
